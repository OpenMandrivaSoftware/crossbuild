# Cross-compile environment for rpmbuild --target.
# Loaded by build-package.sh. Fold into distro-release later.

# Compiler --sysroot and the place target *-devel files are installed.
# Official toolchains and the bootstrap sysroot both live here; usr and
# sys-root are usually symlinks to the prefix itself.
%_cross_sysroot %{_prefix}/%{_target_platform}

# Shell snippet used by %%set_build_flags and by every scriptlet pre.
# Must stay valid shell (no %%if) so it works inside %%__spec_*_pre.
# No-op when not cross-compiling. Does not put the sysroot bindir on
# PATH -- target python/etc. are the wrong ELF for the build host.
%set_cross_env \
  if [ %{cross_compiling} -ne 0 ]; then \
    _cross_root="%{_cross_sysroot}" ; \
    if [ -d "$_cross_root" ]; then \
      CC="${CC:-%__cc}" ; export CC ; \
      CXX="${CXX:-%__cxx}" ; export CXX ; \
      CFLAGS="${CFLAGS:-%build_cflags}" ; export CFLAGS ; \
      CXXFLAGS="${CXXFLAGS:-%build_cxxflags}" ; export CXXFLAGS ; \
      FFLAGS="${FFLAGS:-%build_fflags}" ; export FFLAGS ; \
      FCFLAGS="${FCFLAGS:-%build_fflags}" ; export FCFLAGS ; \
      %{?build_ldflags:LDFLAGS="${LDFLAGS:-%{build_ldflags}}"; export LDFLAGS ;} \
      export PKG_CONFIG_SYSROOT_DIR="${PKG_CONFIG_SYSROOT_DIR:-$_cross_root}" ; \
      export PKG_CONFIG_FDO_SYSROOT_RULES="${PKG_CONFIG_FDO_SYSROOT_RULES:-1}" ; \
      export QEMU_LD_PREFIX="${QEMU_LD_PREFIX:-$_cross_root}" ; \
      _pc_root="$_cross_root/sys-root%{_libdir}/pkgconfig" ; \
      case ":$PKG_CONFIG_PATH:" in \
        *":$_pc_root:"*) ;; \
        *) PKG_CONFIG_PATH="$_pc_root:$_cross_root/sys-root%{_datadir}/pkgconfig:%{_libdir}/pkgconfig:%{_datadir}/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}" ; export PKG_CONFIG_PATH ;; \
      esac ; \
      _wrap="${RPM_BUILD_DIR:-%{_builddir}}/.rpm-cross-wrappers" ; \
      mkdir -p "$_wrap" ; \
      if [ -n "%{?_crossbuild_home}" ] && [ -f "%{_crossbuild_home}/pkg-config-cross" ]; then \
        cp -f "%{_crossbuild_home}/pkg-config-cross" "$_wrap/pkg-config" ; \
      else \
        printf '%s\n' \
          '#!/bin/sh' \
          'var=0; flags=0' \
          'for a in "$@"; do' \
          '  case "$a" in' \
          '  --variable|--variable=*|-variable|--print-variables) var=1 ;;' \
          '  --cflags|--cflags-only-I|--cflags-only-other|--libs|--libs-only-L|--libs-only-other|--libs-only-l) flags=1 ;;' \
          '  esac' \
          'done' \
          'if [ "$var" -eq 1 ] && [ "$flags" -eq 0 ]; then unset PKG_CONFIG_SYSROOT_DIR; fi' \
          'exec /usr/bin/pkg-config "$@"' \
          > "$_wrap/pkg-config" ; \
      fi ; \
      chmod +x "$_wrap/pkg-config" ; \
      ln -sfn pkg-config "$_wrap/pkgconf" ; \
      export PKG_CONFIG="$_wrap/pkg-config" ; \
      export PKG_CONFIG_EXECUTABLE="$_wrap/pkg-config" ; \
      case ":$PATH:" in \
        *":$_wrap:"*) ;; \
        *) PATH="$_wrap:$PATH" ; export PATH ;; \
      esac ; \
      _py_config="" ; \
      for _pc in "$_cross_root"%{_bindir}/python3*-config "$_cross_root"%{_bindir}/python-config ; do \
        if [ -x "$_pc" ]; then _py_config="$_pc" ; break ; fi ; \
      done ; \
      if [ -n "$_py_config" ]; then \
        export PYTHON_CONFIG="${PYTHON_CONFIG:-$_py_config}" ; \
        _wrap="${RPM_BUILD_DIR:-%{_builddir}}/.rpm-cross-wrappers" ; \
        mkdir -p "$_wrap" ; \
        _pyver=$(python -c 'import sys; print("%%d.%%d" %% sys.version_info[:2])' 2>/dev/null) || : ; \
        for _n in python3-config python-config python${_pyver}-config ; do \
          echo '#!/bin/sh' > "$_wrap/$_n" ; \
          echo exec $_py_config '"$@"' >> "$_wrap/$_n" ; \
          chmod +x "$_wrap/$_n" ; \
        done ; \
        case ":$PATH:" in \
          *":$_wrap:"*) ;; \
          *) PATH="$_wrap:$PATH" ; export PATH ;; \
        esac ; \
      fi ; \
      _pyver=$(python -c 'import sys; print("%%d.%%d" %% sys.version_info[:2])' 2>/dev/null) || : ; \
      _pynodots=$(python -c 'import sys; print("%%d%%d" %% sys.version_info[:2])' 2>/dev/null) || : ; \
      if [ -n "$_pyver" ]; then \
        _scsrc="" ; \
        for _d in "$_cross_root%{_libdir}/python${_pyver}" "$_cross_root/usr/lib/python${_pyver}" ; do \
          for _f in "$_d"/_sysconfigdata_*.py ; do \
            if [ -f "$_f" ]; then _scsrc="$_f" ; break ; fi ; \
          done ; \
          [ -n "$_scsrc" ] && break ; \
        done ; \
        if [ -n "$_scsrc" ]; then \
          _scname=$(basename "$_scsrc" .py) ; \
          _scwork="${RPM_BUILD_DIR:-%{_builddir}}/.rpm-cross-sysconfig" ; \
          mkdir -p "$_scwork" ; \
          sed -e "s|'LIBDIR': '/usr/lib64'|'LIBDIR': '${_cross_root}%{_libdir}'|" -e "s|'LIBDIR': '/usr/lib'|'LIBDIR': '${_cross_root}/usr/lib'|" -e "s|'LIBPL': '/usr/|'LIBPL': '${_cross_root}/usr/|" -e "s|'INCLUDEPY': '/usr/|'INCLUDEPY': '${_cross_root}/usr/|" -e "s|'CONFINCLUDEPY': '/usr/|'CONFINCLUDEPY': '${_cross_root}/usr/|" -e "s|'INCLUDEDIR': '/usr/|'INCLUDEDIR': '${_cross_root}/usr/|" "$_scsrc" > "$_scwork/${_scname}.py" ; \
          export _PYTHON_HOST_PLATFORM="${_PYTHON_HOST_PLATFORM:-linux-%{_arch}}" ; \
          export _PYTHON_SYSCONFIGDATA_NAME="${_PYTHON_SYSCONFIGDATA_NAME:-$_scname}" ; \
          export _PYTHON_SYSCONFIGDATA_PATH="${_PYTHON_SYSCONFIGDATA_PATH:-$_scwork}" ; \
          export SETUPTOOLS_EXT_SUFFIX="${SETUPTOOLS_EXT_SUFFIX:-.cpython-${_pynodots}-%{_arch}-linux-gnu.so}" ; \
        fi ; \
      fi ; \
    fi ; \
  fi \
  %{nil}

%set_build_flags \
  CC="${CC:-%__cc}" ; export CC ; \
  CXX="${CXX:-%__cxx}" ; export CXX ; \
  CFLAGS="${CFLAGS:-%build_cflags}" ; export CFLAGS ; \
  CXXFLAGS="${CXXFLAGS:-%build_cxxflags}" ; export CXXFLAGS ; \
  FFLAGS="${FFLAGS:-%build_fflags}" ; export FFLAGS ; \
  FCFLAGS="${FCFLAGS:-%build_fflags}" ; export FCFLAGS ; \
  %{?build_ldflags:LDFLAGS="${LDFLAGS:-%{build_ldflags}}"; export LDFLAGS ;} \
  LT_SYS_LIBRARY_PATH="${LT_SYS_LIBRARY_PATH:-%_libdir:}" ; export LT_SYS_LIBRARY_PATH ; \
%if %{cross_compiling} \
%ifnarch noarch \
    CROSSCOMPILE="%{?!noconftarget:--target=%{_target_platform}} %{?!noconfhost:--host=%{_target_platform}} %{?!noconfbuild:--build=%{_build}}" ; \
%endif \
%else \
%ifnarch noarch \
    CROSSCOMPILE="%{?!noconftarget:--target=%{_target_platform}} %{?!noconfbuild:--build=%{_target_platform}}" ; \
%endif \
%endif \
  %{?cross:CROSSCOMPILE="%{?!noconftarget:--target=%{cross}} %{?!noconfhost:--host=%{_target_platform}} %{?!noconfbuild:--build=%{_build}}" ; } \
  export CROSSCOMPILE ; \
  %{set_cross_env} \
  %{nil}

# Inject the cross environment into every scriptlet, not only specs that
# call %%configure / %%cmake / %%meson / %%set_build_flags.
%__spec_conf_pre	%{___build_pre}%{set_cross_env}
%__spec_build_pre	%{___build_pre}%{set_cross_env}
%__spec_install_pre	%{___build_pre}%{set_cross_env}
%__spec_check_pre	%{___build_pre}%{set_cross_env}
